{
  "name": "quotient",
  "version": "1.0.0",
  "description": "A limit order book and matching engine that implements price-time priority matching — the core mechanism behind how exchanges and trading venues execute orders.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run ts/src/tests",
    "test:watch": "vitest ts/src/tests",
    "dev": "ts-node ts/src/index.ts",
    "start": "node dist/index.js",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend test",
    "benchmark:ts": "npm run build && node dist/benchmarks/matchingEngine.bench.js",
    "benchmark": "powershell -NoProfile -ExecutionPolicy Bypass -File benchmarks/run.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
